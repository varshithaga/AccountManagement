# Copy to .env and adjust. DATABASE_URL and SECRET_KEY are required - the app will not start without them.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/account_management
# DATABASE_URL=sqlite:///./accounting.db   # a local file instead, no PostgreSQL needed
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Any localhost port is also allowed (Vite moves to 5174... when 5173 is busy). Empty it in production:
# CORS_ALLOWED_ORIGIN_REGEX=
AUTH_RATE_LIMIT_PER_MINUTE=20
