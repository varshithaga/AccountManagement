# Copy to .env and adjust. DATABASE_URL and SECRET_KEY are required - the app will not start without them.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/account_management
# DATABASE_URL=sqlite:///./accounting.db   # a local file instead, no PostgreSQL needed
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Any localhost port is also allowed (Vite moves to 5174... when 5173 is busy). Empty it in production:
# CORS_ALLOWED_ORIGIN_REGEX=
AUTH_RATE_LIMIT_PER_MINUTE=20

# Uploaded bank statements are kept here (default: backend/media). Put it on a disk that is backed up.
# MEDIA_ROOT=D:/LedgerDesk/media
# Backups from `python cli.py backup` (default: backend/backups)
# BACKUP_DIR=D:/LedgerDesk/backups
# Where pg_dump is, if it is not on PATH (backups of a PostgreSQL database need it)
# PG_BIN_DIR=C:/Program Files/PostgreSQL/18/bin

# Outgoing email - invoices and payment reminders. Leave SMTP_HOST empty to turn email off.
# Gmail: smtp.gmail.com, port 587, starttls, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# Minutes between checks for recurring invoices that are due (0 = off; run `python cli.py run-recurring` instead)
RECURRING_CHECK_MINUTES=60


# AI Assistant (read-only chat about the books). Gemini is asked first; OpenAI answers when Gemini fails.
# Leave both keys empty to turn it off. The figures it looks up are sent to these services.
# Keys: https://aistudio.google.com/apikey and https://platform.openai.com/api-keys
# Model names change over time - check the providers' current model lists.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_TIMEOUT_SECONDS=60
